{
  "artifact_protocol": "xebpf-paper-protocol-v1",
  "schema_version": "xebpf-1.3.2",
  "collector": "bpftrace-common-v1.3.2",
  "capture_scope": "uid_scoped",
  "raw_identifiers_persisted": false,
  "required_tracepoints": [
    "syscalls/sys_enter_execve",
    "sched/sched_process_exit",
    "syscalls/sys_enter_connect",
    "syscalls/sys_enter_accept4",
    "syscalls/sys_enter_openat",
    "syscalls/sys_enter_unlinkat"
  ],
  "acquisition": {
    "workload_duration_seconds": 120,
    "collector_margin_seconds": 8,
    "rate_per_second": 4,
    "calibration": {
      "protocol": "CAL-1",
      "workload": "controlled-mixed-v1",
      "label": "benign",
      "repetitions": 5
    },
    "benign": {
      "protocol": "BENIGN-1",
      "repetitions_per_profile": 3,
      "profiles": [
        "benign-file-v1",
        "benign-process-v1",
        "benign-network-v1",
        "benign-service-v1",
        "benign-bursty-v1"
      ]
    },
    "attack_emulation": {
      "protocol": "ATTACK-EMULATION-1",
      "repetitions_per_profile": 3,
      "profiles": [
        "ae-file-churn-v1",
        "ae-process-chain-v1",
        "ae-loopback-beacon-v1",
        "ae-staging-v1",
        "ae-mixed-burst-v1"
      ],
      "network_scope": "127.0.0.1 only",
      "filesystem_scope": "isolated /tmp/xebpf-ae1-* only",
      "workload_privilege": "non-root"
    }
  },
  "features": {
    "primary_window_seconds": 5,
    "window_sensitivity_seconds": [
      1,
      5,
      10,
      30
    ],
    "event_types": [
      "FILE_OPEN",
      "NET_ACCEPT",
      "NET_CONNECT",
      "PROCESS_EXEC",
      "PROCESS_EXIT"
    ],
    "non_event_features": [
      "total_events",
      "unique_pids",
      "interarrival_mean",
      "interarrival_std",
      "interarrival_p50"
    ],
    "exclude_from_models": [
      "host",
      "workload",
      "label",
      "rep",
      "window"
    ],
    "analysis_duration_seconds": 120,
    "complete_windows_only": true
  },
  "models": {
    "train_repetitions": [
      1,
      2
    ],
    "test_repetition": 3,
    "lr": {
      "max_iter": 5000,
      "class_weight": "balanced",
      "random_state": 42,
      "standardize": true
    },
    "rf_model1": {
      "n_estimators": 400,
      "class_weight": "balanced_subsample",
      "random_state": 42
    },
    "rf_shift_decomposition": {
      "n_estimators": 20,
      "class_weight": "balanced_subsample",
      "random_state": 42
    },
    "rf_window_sensitivity": {
      "n_estimators": 20,
      "class_weight": "balanced_subsample",
      "random_state": 42
    },
    "rf_feature_ablation_sensitivity": {
      "n_estimators": 5,
      "class_weight": "balanced_subsample",
      "random_state": 42
    },
    "bootstrap": {
      "iterations": 5000,
      "random_state": 42,
      "ci": 0.95,
      "unit": "matched_cell"
    }
  },
  "shift_decomposition": {
    "conditions": [
      "I",
      "E",
      "B",
      "E+B"
    ],
    "held_out_per_cell": {
      "benign_families": 1,
      "malicious_families": 1
    },
    "represented_family_count": 8,
    "seen_regime_control_pair": "next cyclic benign family + next cyclic attack family",
    "equal_training_family_count": 8
  },
  "reproduction_scope": {
    "paper_original_environment_count": 5,
    "minimum_new_environments_for_cross_environment_analysis": 2,
    "recommended_clean_room_environment_count": 3,
    "exact_original_numerical_replication_possible": false,
    "reason": "Original host-derived data are confidential and are not released."
  }
}
